# PHP / Composer
# ============================================================

# Composer
composer.phar
composer.lock
vendor/
vendor.zip

# PHPUnit
.phpunit.result.cache
*.log

# PHP Error Logs
error_log
php_errors.log
*.log

# ============================================================
# Project Specific (Kit Group)
# ============================================================

# Database configuration (contains sensitive credentials)
/includes/config.php
/includes/db.php
/admin/includes/config.php

# Sensitive files
*.env
*.env.*
.env.*.local
.env.local

# Uploaded images (if you don't want to commit them)
# Uncomment if you want to exclude all uploaded images:
# /assets/images/products/
# /assets/images/brands/
# /assets/images/categories/
# /assets/images/about/

# But keep placeholder images:
!/assets/images/products/placeholder.jpg
!/assets/images/brands/placeholder.png
!/assets/images/placeholder.jpg

# Session files (if using file-based sessions)
/sessions/
/tmp/
/cache/

# Backup files
*.bak
*.backup
*.old
*.orig
*.sql
*.sql.gz

# Zip files
*.zip
*.rar
*.tar.gz
*.tgz

# ============================================================
# Server / Hosting
# ============================================================

# Server-specific configs (keep your own)
.htaccess.local
.htpasswd
nginx.conf
httpd.conf

# Cpanel
cpanel.yml
.cpanel.yml

# ============================================================
# Temporary / Development
# ============================================================

# PHP temporary files
php.ini
php.ini.*

# Node modules (if you ever use them)
node_modules/
npm-debug.log
yarn-debug.log
yarn-error.log

# Package lock files
package-lock.json
yarn.lock

# ============================================================
# IDE: VSCode Specific
# ============================================================
.vscode/
*.code-workspace

# ============================================================
# Test & Build Files
# ============================================================

# Testing
/tests/_output/
/tests/_support/_generated/
coverage/
.phpcs-cache
.phpunit.result.cache

# Build artifacts
/build/
/dist/
*.phar

# ============================================================
# Documentation (if autogenerated)
# ============================================================
/docs/_build/
/docs/apidoc/

# ============================================================
# Git Keep
# ============================================================
!.gitkeep